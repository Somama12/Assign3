classDiagram
    %% PawPal+ system design (Phase 1)
    %% Revised after reviewing the skeleton: added Priority, ScheduledTask and
    %% DailyPlan so a plan can carry times, skipped tasks and its explanation.

    class Owner {
        +str name
        +int minutes_available
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet_name) bool
        +get_pet(pet_name) Pet
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age_years
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task_title) bool
        +pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +bool completed
        +mark_complete() None
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time()
    }

    class DailyPlan {
        +str pet_name
        +list~ScheduledTask~ scheduled
        +list~Task~ skipped
        +int minutes_used
        +minutes_remaining(budget) int
    }

    class Scheduler {
        +time day_start
        +build_plan(owner, pet) DailyPlan
        +build_plans(owner) list~DailyPlan~
        +explain(plan) str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : needs care
    Task --> Priority : ranked by
    ScheduledTask --> Task : places
    DailyPlan "1" --> "*" ScheduledTask : contains
    DailyPlan ..> Task : lists skipped
    Scheduler ..> Owner : reads constraints from
    Scheduler ..> Pet : reads tasks from
    Scheduler ..> DailyPlan : produces
