classDiagram
    %% PawPal+ initial design (Phase 1 draft)

    class Owner {
        +str name
        +int minutes_available
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet_name) bool
        +get_pet(pet_name) Pet
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age_years
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task_title) bool
        +pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool completed
        +mark_complete() None
        +priority_rank() int
    }

    class Scheduler {
        +int minutes_available
        +build_plan(pet) list~Task~
        +explain_plan(plan) str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has care
    Scheduler ..> Pet : reads tasks from
    Scheduler ..> Owner : reads constraints from
